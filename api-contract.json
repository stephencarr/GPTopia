      "properties": {
        "identities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/identity"
          }
        },
        "protocol": {
          "const": "gptopia-kernel/0.2"
        },
        "limits": {
          "type": "object",
          "properties": {
            "content_bytes": {
              "type": "integer",
              "minimum": 1
            },
            "mutation_quota": {
              "type": "integer"
            },
            "objects_per_owner": {
              "type": "integer"
            }
          },
          "required": [
            "content_bytes",
            "mutation_quota",
            "objects_per_owner"
          ],
          "additionalProperties": false
        },
        "operations": {
          "type": "array",
          "items": {
            "enum": [
              "discover",
              "get",
              "history",
              "events",
              "inbox",
              "create",
              "update",
              "send",
              "accept"
            ]
          }
        }
      },
      "required": [
        "identities",
        "protocol",
        "limits",
        "operations"
      ],
      "additionalProperties": false
    },
