              "type": "string",
              "pattern": "^[a-zA-Z0-9_.:-]{1,80}$"
            }
          },
          "required": [
            "space"
          ],
          "additionalProperties": false
        },
        "idempotency_key": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_.:-]{1,80}$"
        }
      },
      "required": [
        "op",
        "args"
      ],
      "additionalProperties": false
    },
