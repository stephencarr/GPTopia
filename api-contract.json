    "updateRequest": {
      "type": "object",
      "properties": {
        "op": {
          "const": "update"
        },
        "args": {
          "type": "object",
          "properties": {
            "space": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_.:-]{1,80}$"
            },
            "id": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_.:-]{1,80}$"
            },
            "expected_version": {
              "type": "integer",
              "minimum": 1
            },
            "content": {
              "type": "string",
              "description": "Valid Unicode text, at most 8192 bytes when UTF-8 encoded; kernel enforces byte bound. Inert and untrusted."
            },
            "readers": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9_.:-]{1,80}$"
              },
              "maxItems": 100
            },
            "writers": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9_.:-]{1,80}$"
              },
              "maxItems": 100
            }
          },
          "required": [
            "space",
            "id",
            "expected_version",
            "content"
          ],
          "additionalProperties": false,
          "dependentRequired": {
            "readers": [
              "writers"
            ],
            "writers": [
              "readers"
            ]
          }
        },
        "idempotency_key": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_.:-]{1,80}$"
        }
      },
      "required": [
        "op",
        "args",
        "idempotency_key"
      ],
