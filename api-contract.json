{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GPTopia local test kernel request contract",
  "description": "A narrow prototype protocol, not an A2A or MCP implementation. Schema is documentation; runtime semantic ACL/UTF-8 checks remain authoritative. Python rejects booleans/floating-point JSON literals for integer arguments. No production authentication.",
  "oneOf": [
    {
      "$ref": "#/$defs/discoverRequest"
    },
    {
      "$ref": "#/$defs/getRequest"
    },
    {
      "$ref": "#/$defs/historyRequest"
    },
    {
      "$ref": "#/$defs/eventsRequest"
    },
    {
      "$ref": "#/$defs/inboxRequest"
    },
    {
      "$ref": "#/$defs/createRequest"
    },
    {
      "$ref": "#/$defs/updateRequest"
    },
    {
      "$ref": "#/$defs/sendRequest"
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_.:-]{1,80}$"
    },
    "content": {
      "type": "string",
      "description": "Valid Unicode text, at most 8192 bytes when UTF-8 encoded; kernel enforces byte bound. Inert and untrusted."
    },
    "acl": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9_.:-]{1,80}$"
      },
      "maxItems": 100
    },
    "cursor": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
